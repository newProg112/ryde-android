rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validDisplayName(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 60
        && value.matches('.*[^\\s].*')
        && !value.matches('.*[\\x00-\\x1F\\x7F-\\x9F].*');
    }

    function validBroadArea(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 60
        && !value.matches('.*[0-9,].*')
        && !value.matches('.*[\\x00-\\x1F\\x7F-\\x9F].*');
    }

    function signedIn() {
      return request.auth != null;
    }

    function journeyPath(journeyId) {
      return /databases/$(database)/documents/journeys/$(journeyId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function seatRequestPath(requestId) {
      return /databases/$(database)/documents/seatRequests/$(requestId);
    }

    function acceptanceGuardPath(journeyId) {
      return /databases/$(database)/documents/journeyAcceptanceGuards/$(journeyId);
    }

    function confirmedTripPath(tripId) {
      return /databases/$(database)/documents/confirmedTrips/$(tripId);
    }

    function validMessage(data) {
      return data.keys().hasOnly(['senderUid', 'body', 'sentAt'])
        && data.keys().hasAll(['senderUid', 'body', 'sentAt'])
        && data.senderUid is string
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 500
        && data.body.matches('.*[^\\s].*')
        && !data.body.matches('.*[\\x00-\\x1F\\x7F-\\x9F].*')
        && data.sentAt is timestamp;
    }

    function validJourney(data) {
      return data.keys().hasOnly([
          'driverUid', 'originArea', 'destinationArea', 'departureAt',
          'seatCapacity', 'seatsRemaining', 'status', 'cancelledAt', 'completedAt'
        ])
        && data.driverUid is string
        && validBroadArea(data.originArea)
        && validBroadArea(data.destinationArea)
        && data.originArea != data.destinationArea
        && data.departureAt is timestamp
        && data.seatCapacity is int
        && data.seatCapacity >= 1 && data.seatCapacity <= 8
        && data.seatsRemaining is int
        && data.seatsRemaining >= 0 && data.seatsRemaining <= data.seatCapacity
        && ((data.status == 'OPEN' && !('cancelledAt' in data)
              && !('completedAt' in data))
          || (data.status == 'CANCELLED' && data.cancelledAt is timestamp
              && !('completedAt' in data))
          || (data.status == 'COMPLETED' && data.completedAt is timestamp
              && !('cancelledAt' in data)));
    }

    function validSeatRequest(data) {
      return data.keys().hasOnly(['journeyId', 'driverUid', 'riderUid', 'status', 'riderDisplayName'])
        && data.keys().hasAll(['journeyId', 'driverUid', 'riderUid', 'status'])
        && data.journeyId is string
        && data.driverUid is string
        && data.riderUid is string
        && data.driverUid != data.riderUid
        && (!('riderDisplayName' in data) || validDisplayName(data.riderDisplayName))
        && data.status in ['PENDING', 'ACCEPTED', 'DECLINED', 'CANCELLED', 'CANCELLED_AFTER_ACCEPTANCE'];
    }

    function requestSnapshotMatchesRiderProfile(data) {
      return 'riderDisplayName' in data
        && validDisplayName(data.riderDisplayName)
        && exists(userPath(data.riderUid))
        && get(userPath(data.riderUid)).data.uid == data.riderUid
        && validDisplayName(get(userPath(data.riderUid)).data.displayName)
        && data.riderDisplayName == get(userPath(data.riderUid)).data.displayName;
    }

    function validAcceptanceGuard(data) {
      return data.keys().hasOnly(['driverUid', 'acceptanceCount', 'lastAcceptedRequestId', 'lastCancelledRequestId'])
        && data.driverUid is string
        && data.acceptanceCount is int
        && data.acceptanceCount >= 0
        && data.acceptanceCount <= 8
        && ((data.acceptanceCount == 0 && data.lastAcceptedRequestId == null)
          || (data.lastAcceptedRequestId is string
            && data.lastAcceptedRequestId.size() > 0))
        && (!('lastCancelledRequestId' in data)
          || (data.lastCancelledRequestId is string && data.lastCancelledRequestId.size() > 0));
    }

    function validConfirmedTrip(data) {
      return data.keys().hasOnly([
          'journeyId', 'acceptedRequestId', 'driverUid', 'riderUid',
          'originArea', 'destinationArea', 'departureAt', 'status', 'cancelledAt',
          'driverDisplayName'
        ])
        && data.journeyId is string
        && data.acceptedRequestId is string
        && data.driverUid is string
        && data.riderUid is string
        && data.driverUid != data.riderUid
        && validBroadArea(data.originArea)
        && validBroadArea(data.destinationArea)
        && data.originArea != data.destinationArea
        && data.departureAt is timestamp
        && ((data.status == 'CONFIRMED' && !('cancelledAt' in data))
          || (data.status == 'CANCELLED_BY_RIDER' && data.cancelledAt is timestamp));
    }

    function validConfirmedTripIdentity(tripId, trip) {
      return validConfirmedTrip(trip)
        && tripId.size() > 0
        && trip.journeyId.size() > 0
        && trip.acceptedRequestId.size() > 0
        && trip.driverUid.size() > 0
        && trip.riderUid.size() > 0
        && tripId == trip.acceptedRequestId
        && trip.acceptedRequestId == trip.journeyId + '_' + trip.riderUid;
    }

    function messageParticipant(tripId) {
      let trip = get(confirmedTripPath(tripId)).data;
      return signedIn()
        && validConfirmedTripIdentity(tripId, trip)
        && (trip.driverUid == request.auth.uid || trip.riderUid == request.auth.uid);
    }

    function coordinationIsActive(tripId) {
      let trip = get(confirmedTripPath(tripId)).data;
      let journey = get(journeyPath(trip.journeyId)).data;
      return validConfirmedTripIdentity(tripId, trip)
        && trip.status == 'CONFIRMED'
        && validJourney(journey)
        && journey.status == 'OPEN'
        && journey.driverUid == trip.driverUid
        && journey.originArea == trip.originArea
        && journey.destinationArea == trip.destinationArea
        && journey.departureAt == trip.departureAt;
    }

    function confirmedTripSnapshotMatchesDriverProfile(data) {
      let driverProfile = get(userPath(data.driverUid)).data;
      return 'driverDisplayName' in data
        && driverProfile.uid == data.driverUid
        && validDisplayName(driverProfile.displayName)
        && data.driverDisplayName == driverProfile.displayName;
    }

    function currentGuardMatchesJourney(journeyId, driverUid) {
      let journey = get(journeyPath(journeyId)).data;
      let guard = get(acceptanceGuardPath(journeyId)).data;
      return validJourney(journey)
        && journey.status == 'OPEN'
        && validAcceptanceGuard(guard)
        && journey.driverUid == driverUid
        && guard.driverUid == driverUid
        && guard.acceptanceCount == journey.seatCapacity - journey.seatsRemaining;
    }

    function journeyDecrementsOnce(journeyId, driverUid) {
      let before = get(journeyPath(journeyId)).data;
      let after = getAfter(journeyPath(journeyId)).data;
      // Unchanged fields retain their validated types; the exact integer delta
      // from positive remaining capacity also proves all after-state bounds.
      return validJourney(before)
        && before.status == 'OPEN' && after.status == 'OPEN'
        && before.driverUid == driverUid
        && after.driverUid == driverUid
        && after.seatCapacity is int && after.seatsRemaining is int
        && after.diff(before).affectedKeys().hasOnly(['seatsRemaining'])
        && before.seatsRemaining > 0
        && before.departureAt > request.time
        && after.seatsRemaining == before.seatsRemaining - 1;
    }

    function guardAdvancesForRequest(journeyId, driverUid, requestId) {
      let before = get(acceptanceGuardPath(journeyId)).data;
      let after = getAfter(acceptanceGuardPath(journeyId)).data;
      // The linked journey/count invariant bounds the incremented count.
      return validAcceptanceGuard(before)
        && before.driverUid == driverUid
        && after.driverUid == driverUid
        && after.acceptanceCount is int
        && after.diff(before).affectedKeys()
          .hasOnly(['acceptanceCount', 'lastAcceptedRequestId'])
        && after.acceptanceCount == before.acceptanceCount + 1
        && after.lastAcceptedRequestId == requestId;
    }

    function guardAndJourneyCountsAdvanceTogether(journeyId) {
      let journeyBefore = get(journeyPath(journeyId)).data;
      let journeyAfter = getAfter(journeyPath(journeyId)).data;
      let guardBefore = get(acceptanceGuardPath(journeyId)).data;
      let guardAfter = getAfter(acceptanceGuardPath(journeyId)).data;
      return guardBefore.acceptanceCount
          == journeyBefore.seatCapacity - journeyBefore.seatsRemaining
        && guardAfter.acceptanceCount
          == journeyAfter.seatCapacity - journeyAfter.seatsRemaining;
    }

    function requestTransitionsToAccepted(journeyId, driverUid, requestId) {
      let before = get(seatRequestPath(requestId)).data;
      let after = getAfter(seatRequestPath(requestId)).data;
      return validSeatRequest(before)
        && requestId == before.journeyId + '_' + before.riderUid
        && before.journeyId == journeyId
        && before.driverUid == driverUid
        && after.diff(before).affectedKeys().hasOnly(['status'])
        && before.status == 'PENDING'
        && after.status == 'ACCEPTED';
    }

    function confirmedTripIsCreated(requestId) {
      return !exists(confirmedTripPath(requestId))
        && existsAfter(confirmedTripPath(requestId));
    }

    function confirmedTripIsCreatedForJourney(requestId, journeyId) {
      return confirmedTripIsCreated(requestId)
        && getAfter(confirmedTripPath(requestId)).data.journeyId == journeyId;
    }

    function confirmedTripMatchesSource(tripId, trip) {
      let seatRequest = get(seatRequestPath(tripId)).data;
      let journey = get(journeyPath(seatRequest.journeyId)).data;
      return tripId == seatRequest.journeyId + '_' + seatRequest.riderUid
        && trip.acceptedRequestId == tripId
        && trip.journeyId == seatRequest.journeyId
        && trip.driverUid == seatRequest.driverUid
        && trip.riderUid == seatRequest.riderUid
        && trip.originArea == journey.originArea
        && trip.destinationArea == journey.destinationArea
        && trip.departureAt == journey.departureAt;
    }

    // The trip update proves all four writes. The other three writes require that
    // trip transition, so none can commit without the full proof being evaluated.
    function tripTransitionsToRiderCancelled(requestId, journeyId) {
      let before = get(confirmedTripPath(requestId)).data;
      let after = getAfter(confirmedTripPath(requestId)).data;
      return before.riderUid == request.auth.uid
        && before.journeyId == journeyId
        && before.status == 'CONFIRMED'
        && after.status == 'CANCELLED_BY_RIDER';
    }

    // The guard pointer binds one released allocation to one terminal booking.
    function riderCancelsConfirmedSeat(requestId) {
      let tripBefore = get(confirmedTripPath(requestId)).data;
      let tripAfter = getAfter(confirmedTripPath(requestId)).data;
      let requestBefore = get(seatRequestPath(requestId)).data;
      let requestAfter = getAfter(seatRequestPath(requestId)).data;
      let journeyBefore = get(journeyPath(tripBefore.journeyId)).data;
      let journeyAfter = getAfter(journeyPath(tripBefore.journeyId)).data;
      let guardBefore = get(acceptanceGuardPath(tripBefore.journeyId)).data;
      let guardAfter = getAfter(acceptanceGuardPath(tripBefore.journeyId)).data;
      // Before-state validation, immutable-field diffs and exact deltas prove
      // the after shapes without duplicating expensive schema checks.
      return tripBefore.riderUid == request.auth.uid
        && validConfirmedTrip(tripBefore)
        && tripBefore.status == 'CONFIRMED' && tripAfter.status == 'CANCELLED_BY_RIDER'
        && tripAfter.cancelledAt == request.time
        && tripAfter.diff(tripBefore).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && confirmedTripMatchesSource(requestId, tripBefore)
        && validSeatRequest(requestBefore)
        && requestBefore.status == 'ACCEPTED' && requestAfter.status == 'CANCELLED_AFTER_ACCEPTANCE'
        && requestAfter.diff(requestBefore).affectedKeys().hasOnly(['status'])
        && validJourney(journeyBefore)
        && journeyBefore.status == 'OPEN' && journeyAfter.status == 'OPEN'
        && journeyAfter.seatCapacity is int && journeyAfter.seatsRemaining is int
        && journeyBefore.departureAt > request.time
        && journeyAfter.diff(journeyBefore).affectedKeys().hasOnly(['seatsRemaining'])
        && journeyAfter.seatsRemaining == journeyBefore.seatsRemaining + 1
        && validAcceptanceGuard(guardBefore)
        && guardAfter.acceptanceCount is int
        && guardBefore.driverUid == journeyBefore.driverUid
        && guardAfter.diff(guardBefore).affectedKeys().hasOnly(['acceptanceCount', 'lastCancelledRequestId'])
        && guardBefore.acceptanceCount > 0
        && guardAfter.acceptanceCount == guardBefore.acceptanceCount - 1
        && guardAfter.lastCancelledRequestId == requestId
        && guardBefore.acceptanceCount == journeyBefore.seatCapacity - journeyBefore.seatsRemaining
        && guardAfter.acceptanceCount == journeyAfter.seatCapacity - journeyAfter.seatsRemaining;
    }

    match /users/{uid} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == uid
        && validDisplayName(request.resource.data.displayName);
      allow update: if owns(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid
        && validDisplayName(request.resource.data.displayName);

      match /savedPlaces/{placeId} {
        allow read, delete: if owns(uid);
        allow create: if owns(uid)
          && placeId in ['home', 'work']
          && request.resource.data.keys().hasOnly(['uid', 'label', 'area'])
          && request.resource.data.uid == uid
          && request.resource.data.label == (placeId == 'home' ? 'Home' : 'Work')
          && validBroadArea(request.resource.data.area);
        allow update: if owns(uid)
          && placeId in ['home', 'work']
          && request.resource.data.keys().hasOnly(['uid', 'label', 'area'])
          && request.resource.data.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.label == (placeId == 'home' ? 'Home' : 'Work')
          && validBroadArea(request.resource.data.area);
      }
    }

    match /journeys/{journeyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.driverUid == request.auth.uid
        && validJourney(request.resource.data)
        && request.resource.data.status == 'OPEN'
        && request.resource.data.seatsRemaining == request.resource.data.seatCapacity
        && request.resource.data.departureAt > request.time
        && !exists(acceptanceGuardPath(journeyId))
        && existsAfter(acceptanceGuardPath(journeyId))
        && validAcceptanceGuard(getAfter(acceptanceGuardPath(journeyId)).data)
        && getAfter(acceptanceGuardPath(journeyId)).data.driverUid == request.auth.uid
        && getAfter(acceptanceGuardPath(journeyId)).data.acceptanceCount == 0
        && getAfter(acceptanceGuardPath(journeyId)).data.lastAcceptedRequestId == null;
      allow update: if signedIn()
        && resource.data.driverUid == request.auth.uid
        && request.resource.data.seatsRemaining == resource.data.seatsRemaining - 1
        && confirmedTripIsCreatedForJourney(
          getAfter(acceptanceGuardPath(journeyId)).data.lastAcceptedRequestId, journeyId);
      allow update: if signedIn()
        && request.resource.data.seatsRemaining == resource.data.seatsRemaining + 1
        && tripTransitionsToRiderCancelled(
          getAfter(acceptanceGuardPath(journeyId)).data.lastCancelledRequestId, journeyId);
      // Only the journey changes. Its linked records retain their source history;
      // all booking writes require OPEN, and the private guard stays frozen.
      allow update: if signedIn()
        && resource.data.driverUid == request.auth.uid
        && resource.data.status == 'OPEN'
        && resource.data.departureAt > request.time
        && validJourney(resource.data)
        && request.resource.data.status == 'CANCELLED'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.seatCapacity is int && request.resource.data.seatsRemaining is int
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && currentGuardMatchesJourney(journeyId, request.auth.uid)
        && getAfter(acceptanceGuardPath(journeyId)).data == get(acceptanceGuardPath(journeyId)).data;
      // Completion is the driver's one-way post-departure closure. Linked private
      // records and allocation truth remain immutable history.
      allow update: if signedIn()
        && resource.data.driverUid == request.auth.uid
        && resource.data.status == 'OPEN'
        && resource.data.departureAt <= request.time
        && validJourney(resource.data)
        && request.resource.data.status == 'COMPLETED'
        && request.resource.data.completedAt == request.time
        && request.resource.data.seatCapacity is int && request.resource.data.seatsRemaining is int
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt'])
        && currentGuardMatchesJourney(journeyId, request.auth.uid)
        && getAfter(acceptanceGuardPath(journeyId)).data == get(acceptanceGuardPath(journeyId)).data;
      allow delete: if false;
    }

    match /journeyAcceptanceGuards/{journeyId} {
      allow get: if signedIn() && resource.data.driverUid == request.auth.uid;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['driverUid', 'acceptanceCount', 'lastAcceptedRequestId'])
        && request.resource.data.driverUid == request.auth.uid
        && validAcceptanceGuard(request.resource.data)
        && request.resource.data.acceptanceCount == 0
        && request.resource.data.lastAcceptedRequestId == null
        && !exists(journeyPath(journeyId))
        && existsAfter(journeyPath(journeyId))
        && validJourney(getAfter(journeyPath(journeyId)).data)
        && getAfter(journeyPath(journeyId)).data.status == 'OPEN'
        && getAfter(journeyPath(journeyId)).data.driverUid == request.auth.uid
        && getAfter(journeyPath(journeyId)).data.seatsRemaining
          == getAfter(journeyPath(journeyId)).data.seatCapacity;
      allow update: if signedIn()
        && resource.data.driverUid == request.auth.uid
        && request.resource.data.acceptanceCount == resource.data.acceptanceCount + 1
        && confirmedTripIsCreatedForJourney(request.resource.data.lastAcceptedRequestId, journeyId);
      allow update: if signedIn()
        && request.resource.data.acceptanceCount == resource.data.acceptanceCount - 1
        && tripTransitionsToRiderCancelled(request.resource.data.lastCancelledRequestId, journeyId);
      allow delete: if false;
    }

    match /seatRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.riderUid == request.auth.uid || resource.data.driverUid == request.auth.uid);
      allow create: if signedIn()
        && validSeatRequest(request.resource.data)
        && requestSnapshotMatchesRiderProfile(request.resource.data)
        && request.resource.data.riderUid == request.auth.uid
        && request.resource.data.driverUid != request.auth.uid
        && requestId == request.resource.data.journeyId + '_' + request.auth.uid
        && request.resource.data.status == 'PENDING'
        && exists(journeyPath(request.resource.data.journeyId))
        && get(journeyPath(request.resource.data.journeyId)).data.driverUid == request.resource.data.driverUid
        && get(journeyPath(request.resource.data.journeyId)).data.status == 'OPEN'
        && getAfter(journeyPath(request.resource.data.journeyId)).data.status == 'OPEN'
        && get(journeyPath(request.resource.data.journeyId)).data.departureAt > request.time
        && get(journeyPath(request.resource.data.journeyId)).data.seatsRemaining > 0
        && currentGuardMatchesJourney(
          request.resource.data.journeyId,
          request.resource.data.driverUid);
      allow update: if signedIn()
        && resource.data.riderUid == request.auth.uid
        && get(journeyPath(resource.data.journeyId)).data.status == 'OPEN'
        && getAfter(journeyPath(resource.data.journeyId)).data.status == 'OPEN'
        && validSeatRequest(resource.data)
        && validSeatRequest(request.resource.data)
        && requestId == resource.data.journeyId + '_' + resource.data.riderUid
        && request.resource.data.journeyId == resource.data.journeyId
        && request.resource.data.driverUid == resource.data.driverUid
        && request.resource.data.riderUid == resource.data.riderUid
        && ((resource.data.status == 'PENDING'
            && request.resource.data.status == 'CANCELLED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          || (resource.data.status == 'CANCELLED'
            && request.resource.data.status == 'PENDING'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'riderDisplayName'])
            && requestSnapshotMatchesRiderProfile(request.resource.data)
            && exists(journeyPath(resource.data.journeyId))
            && get(journeyPath(resource.data.journeyId)).data.driverUid == resource.data.driverUid
            && get(journeyPath(resource.data.journeyId)).data.status == 'OPEN'
            && get(journeyPath(resource.data.journeyId)).data.departureAt > request.time
            && get(journeyPath(resource.data.journeyId)).data.seatsRemaining > 0
            && currentGuardMatchesJourney(
              resource.data.journeyId,
              resource.data.driverUid)));
      allow update: if signedIn()
        && resource.data.driverUid == request.auth.uid
        && get(journeyPath(resource.data.journeyId)).data.status == 'OPEN'
        && getAfter(journeyPath(resource.data.journeyId)).data.status == 'OPEN'
        && get(journeyPath(resource.data.journeyId)).data.driverUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'PENDING'
        && request.resource.data.status in ['ACCEPTED', 'DECLINED']
        && ((request.resource.data.status == 'DECLINED'
            && currentGuardMatchesJourney(resource.data.journeyId, request.auth.uid))
          || (request.resource.data.status == 'ACCEPTED'
            && confirmedTripIsCreated(requestId)));
      allow update: if signedIn()
        && resource.data.status == 'ACCEPTED'
        && request.resource.data.status == 'CANCELLED_AFTER_ACCEPTANCE'
        && tripTransitionsToRiderCancelled(requestId, resource.data.journeyId);
      allow delete: if false;
    }

    match /confirmedTrips/{tripId} {
      allow read: if signedIn()
        && (resource.data.driverUid == request.auth.uid
          || resource.data.riderUid == request.auth.uid);
      allow create: if signedIn()
        && validConfirmedTrip(request.resource.data)
        && confirmedTripSnapshotMatchesDriverProfile(request.resource.data)
        && request.resource.data.status == 'CONFIRMED'
        && tripId == request.resource.data.acceptedRequestId
        && request.resource.data.driverUid == request.auth.uid
        && confirmedTripMatchesSource(tripId, request.resource.data)
        && requestTransitionsToAccepted(
          request.resource.data.journeyId,
          request.auth.uid,
          tripId)
        && journeyDecrementsOnce(request.resource.data.journeyId, request.auth.uid)
        && guardAdvancesForRequest(
          request.resource.data.journeyId,
          request.auth.uid,
          tripId)
        && guardAndJourneyCountsAdvanceTogether(request.resource.data.journeyId);
      allow update: if signedIn()
        && resource.data.riderUid == request.auth.uid
        && resource.data.status == 'CONFIRMED'
        && request.resource.data.status == 'CANCELLED_BY_RIDER'
        && riderCancelsConfirmedSeat(tripId);
      allow delete: if false;

      match /messages/{messageId} {
        // History remains available to the immutable trip participants even when
        // the linked journey is cancelled, missing, or no longer coherent.
        allow read: if messageParticipant(tripId);
        allow create: if messageParticipant(tripId)
          && messageId.matches('[A-Za-z0-9_-]{1,128}')
          && validMessage(request.resource.data)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.sentAt == request.time
          && coordinationIsActive(tripId);
        allow update, delete: if false;
      }
    }

    // Explicit default deny: all unmigrated capabilities remain inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
